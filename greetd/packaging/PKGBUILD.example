# Maintainer: HorneroOS <https://github.com/HorneroOS>
# Reference PKGBUILD for the greetd greeter (AUR: hornero-greeter-greetd).
# Kept in-repo as the packaging contract; AUR publication follows the
# same tag-driven stamp flow as hornero-greeter.
pkgname=hornero-greeter-greetd
pkgver=0.1.0
pkgrel=1
pkgdesc="HorneroOS graphical greeter for greetd (Hornero Signal, Qt6)"
arch=("x86_64")
url="https://github.com/HorneroOS/greeter"
license=("GPL-3.0-only")
depends=("greetd" "cage" "qt6-base" "qt6-declarative" "ttf-ibm-plex")
makedepends=("cmake" "ninja" "qt6-tools")
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cmake -S "greeter-$pkgver/greetd" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "greeter-$pkgver/greetd/config/config.toml.example" \
    "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
