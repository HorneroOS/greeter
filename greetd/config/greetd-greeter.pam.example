#%PAM-1.0
# Example /etc/pam.d/greetd-greeter — the PAM stack greetd uses for the
# greeter session itself (not for user logins; that is /etc/pam.d/greetd).
#
# Why this file matters: greetd asks PAM for the "greetd-greeter"
# service, but some greetd packages (Arch included) only ship
# /etc/pam.d/greetd. PAM then falls back to /etc/pam.d/other, which has
# no pam_systemd session hook: the greeter gets no logind seat session
# and cage/wlroots exits with "No backend was able to open a seat".
#
# Validated in a clean Arch VM (seat0, DRM modeset, greeter running).
# The greeter session is not password-authenticated — greetd starts it
# as the unprivileged greeter user — so auth is pam_permit; account and
# session stay strict, and pam_systemd registers the seat session.
auth       required     pam_permit.so
account    required     pam_unix.so
password   required     pam_deny.so
session    required     pam_loginuid.so
session    optional     pam_keyinit.so revoke
-session   optional     pam_systemd.so
session    required     pam_limits.so
session    required     pam_unix.so
