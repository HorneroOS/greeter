{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HorneroOS greeter clip source manifest",
  "description": "Source-side metadata for one greeter video clip. These manifests are NOT runtime files: they document provenance and licensing so the clip can be re-fetched, verified, and transcoded at image build time. Runtime files must never contain network URLs (see CONTRIBUTING_MEDIA.md).",
  "type": "object",
  "required": [
    "id",
    "title",
    "location",
    "creator",
    "source",
    "license",
    "review",
    "original",
    "dayparts",
    "edit",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ar-[a-z0-9-]+$",
      "description": "Stable clip id, prefixed with ar-."
    },
    "title": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "required": ["place", "province", "region", "country"],
      "properties": {
        "place": { "type": "string" },
        "province": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string", "const": "Argentina" }
      }
    },
    "creator": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["page", "file"],
      "properties": {
        "page": {
          "type": "string",
          "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:",
          "description": "Wikimedia Commons file description page (inspected for license)."
        },
        "file": { "type": "string", "description": "Original filename on Commons." }
      }
    },
    "license": {
      "type": "object",
      "required": ["short", "name", "url"],
      "properties": {
        "short": {
          "type": "string",
          "enum": ["CC0-1.0", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-3.0", "CC-BY-SA-4.0"],
          "description": "Ship policy: only CC0 / CC-BY / CC-BY-SA are accepted."
        },
        "name": { "type": "string" },
        "url": {
          "type": "string",
          "pattern": "^https://creativecommons\\.org/(publicdomain/zero/1\\.0|licenses/(by|by-sa)/[34]\\.0)"
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["own-work", "reviewed", "written-permission", "license-review-needed", "review-pending"],
          "description": "Only own-work, reviewed, or written-permission may ship in media/manifests/. Anything else lives in media/candidates/."
        },
        "reviewer": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "original": {
      "type": "object",
      "required": ["bytes", "sha256", "duration_s", "width", "height", "container"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of the original file as downloaded from Commons. Null only in media/candidates/ for files not yet fetched; must be filled before promotion to media/manifests/."
        },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "container": { "type": "string", "enum": ["webm", "ogv"] }
      }
    },
    "dayparts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["day", "night"] }
    },
    "edit": {
      "type": "object",
      "required": ["trim_start_s", "trim_end_s", "crop", "scale", "audio"],
      "properties": {
        "trim_start_s": { "type": "number", "minimum": 0 },
        "trim_end_s": { "type": "number", "exclusiveMinimum": 0 },
        "crop": { "type": "string", "minLength": 1 },
        "scale": { "type": "string", "minLength": 1 },
        "audio": { "type": "string", "enum": ["strip", "none"] }
      }
    },
    "notes": { "type": "string" }
  }
}
